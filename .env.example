# FOBAL lobby server — environment reference. Copy what you need; NEVER
# commit real values for anything marked SECRET. Deployed environments get
# secrets from AWS Secrets Manager via the CDK task definition, never from
# files.

# ---- core ----
PORT=8475
FOBAL_CREATE_KEY=                 # SECRET — match-server create key (required)
FOBAL_LOBBY_SECRET=               # SECRET — session HMAC (generated when unset)
FOBAL_LOBBY_STORE=var/lobby
FOBAL_MATCH_URL=http://localhost:8473
#FOBAL_PUBLIC_MATCH_URL=          # browser-facing match server (default: FOBAL_MATCH_URL)
FOBAL_DEV_AUTH=1                  # local dev ONLY: login codes returned in responses

# ---- outbound email (login codes + match invitations) ----
# Backend 'ses': uses task-role IAM in AWS, needs NO key material. The
# fobal.ai identity is verified; until SES production access is granted the
# account is sandboxed (verified recipients only).
# Backend 'resend': set an API key from a dev account at resend.com —
# unverified accounts can only send to their own address, which makes it
# spam-safe for development. Verify the fobal.ai domain in the Resend
# dashboard (3 DNS records) before real recipients.
#FOBAL_EMAIL_BACKEND=resend
FOBAL_EMAIL_FROM=matches@fobal.ai
#FOBAL_RESEND_API_KEY=            # SECRET — server-side only, never in client code
#FOBAL_EMAIL_WEBHOOK_SECRET=      # SECRET — Resend webhook signing secret (whsec_…)
FOBAL_INVITE_BASE_URL=http://localhost:8492   # public client base for invite links

# ---- chain (M5) ----
#FOBAL_RPC_URL=https://sepolia.base.org
#FOBAL_CHAIN_PLAYER=              # FobalPlayer address
#FOBAL_CHAIN_REGISTRY=            # FobalTeamRegistry address
#FOBAL_CHAIN_GENERATOR=           # FobalPlayerGenerator address (mint)
#FOBAL_CHAIN_ID=84532
#FOBAL_GENERATOR_SIGNER_PK=       # SECRET — SquadMint permit signer

# ---- misc ----
#FOBAL_TEST_LOGIN_KEY=            # SECRET — acceptance backdoor
#FOBAL_CORS_ORIGIN=*
#FOBAL_LOBBY_BACKEND=file         # 'file' | 's3'
#FOBAL_LOBBY_BUCKET=
