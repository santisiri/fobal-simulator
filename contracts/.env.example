# Fobal Protocol — environment template. Copy to .env and fill in.
# NEVER commit .env. Never put private keys in this file — use
# `cast wallet import` / `--account` (Foundry keystore) for signing keys.

# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Contract verification
BASESCAN_API_KEY=your_basescan_api_key

# Protocol authorities (addresses only — keys stay in the keystore)
# On mainnet, FOBAL_ADMIN MUST be a multisig (e.g. a Safe).
FOBAL_ADMIN=0x0000000000000000000000000000000000000000
FOBAL_TREASURY=0x0000000000000000000000000000000000000000
FOBAL_GENERATOR_SIGNER=0x0000000000000000000000000000000000000000
FOBAL_ENGINE_SIGNER=0x0000000000000000000000000000000000000000
